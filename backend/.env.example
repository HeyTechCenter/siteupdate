# ── Serveur ──────────────────────────────────────
PORT=5000

# ── MongoDB Atlas (facultatif) ────────────────────
# Sans MONGO_URI, les messages du formulaire sont seulement envoyés par email
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/heytech?retryWrites=true&w=majority

# ── Email (Gmail) ─────────────────────────────────
# L'adresse Gmail officielle de HeyTech Center
EMAIL_USER=heytech@gmail.com
# Mot de passe d'application Gmail (pas ton vrai mot de passe)
# Générer ici : https://myaccount.google.com/apppasswords
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ── CORS ─────────────────────────────────────────
# Origines autorisées, séparées par des virgules
# En développement : CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN=https://heytech.top,https://www.heytech.top
